---
import Layout from '../layouts/Layout.astro';
import siteConfig from '../data/site.config.json';

const typeOptions = [
  { value: 'request', label: '地域活性化支援の依頼' },
  { value: 'venue',   label: '活動場所の提供' },
  { value: 'join',    label: '活動への参加' },
  { value: 'other',   label: 'その他' },
];
---

<Layout
  title="お問い合わせ"
  description="一般社団法人 桜の風へのお問い合わせ・ご相談はこちらから。地域活性化支援・活動場所の提供・参加希望など、お気軽にご連絡ください。"
  showCTA={false}
>

  <!-- ページヒーロー -->
  <section class="bg-gradient-to-b from-sakura-50 to-white pt-14 pb-10 px-4 md:px-8 text-center">
    <p class="text-xs font-semibold tracking-widest text-sakura-400 uppercase mb-3">Contact</p>
    <h1 class="font-heading text-3xl md:text-4xl font-semibold text-sakura-900">お問い合わせ</h1>
    <div class="mt-4 flex justify-center">
      <span class="block w-14 h-1 rounded-full bg-sakura-300"></span>
    </div>
    <p class="mt-6 text-base text-gray-600 max-w-xl mx-auto leading-relaxed">
      ご相談・お問い合わせはフォームまたはお電話・メールにてお気軽にどうぞ。
    </p>
  </section>

  <div class="max-w-2xl mx-auto px-4 md:px-8 pb-20 mt-12">

    <!-- お問い合わせフォーム -->
    <!--
      Netlify: <form netlify name="contact" ...> に変更して使用
      Vercel + Formspree: action="https://formspree.io/f/xxxxx" method="POST" に変更して使用
    -->
    <form
      id="contact-form"
      name="contact"
      method="POST"
      action="/contact/thanks"
      data-netlify="true"
      data-netlify-honeypot="website"
      novalidate
      class="space-y-10"
    >
      <!-- hidden: Netlify フォーム識別 -->
      <input type="hidden" name="form-name" value="contact" />

      <!-- ハニーポット（ボット対策：ユーザーには見えない） -->
      <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;">
        <label for="website">このフィールドは入力しないでください</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <!-- お名前 -->
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-2.5">
          お名前
          <span class="ml-1.5 text-xs font-normal text-white bg-sakura-500 px-2 py-0.5 rounded inline-block align-middle leading-none">必須</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          placeholder="山田 太郎"
          class="w-full rounded-lg border border-gray-300 px-4 py-3.5 text-sm text-gray-800 placeholder-gray-400
                 focus:outline-none focus:ring-2 focus:ring-sakura-400 focus:border-transparent transition"
        />
      </div>

      <!-- 組織名 -->
      <div>
        <label for="organization" class="block text-sm font-medium text-gray-700 mb-2.5">
          組織名
          <span class="ml-1.5 text-xs font-normal text-gray-400 bg-gray-100 px-2 py-0.5 rounded inline-block align-middle leading-none">任意</span>
        </label>
        <input
          type="text"
          id="organization"
          name="organization"
          autocomplete="organization"
          placeholder="〇〇株式会社・〇〇市役所"
          class="w-full rounded-lg border border-gray-300 px-4 py-3.5 text-sm text-gray-800 placeholder-gray-400
                 focus:outline-none focus:ring-2 focus:ring-sakura-400 focus:border-transparent transition"
        />
      </div>

      <!-- メールアドレス -->
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-2.5">
          メールアドレス
          <span class="ml-1.5 text-xs font-normal text-white bg-sakura-500 px-2 py-0.5 rounded inline-block align-middle leading-none">必須</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder="example@mail.com"
          class="w-full rounded-lg border border-gray-300 px-4 py-3.5 text-sm text-gray-800 placeholder-gray-400
                 focus:outline-none focus:ring-2 focus:ring-sakura-400 focus:border-transparent transition"
        />
      </div>

      <!-- 電話番号 -->
      <div>
        <label for="phone" class="block text-sm font-medium text-gray-700 mb-2.5">
          電話番号
          <span class="ml-1.5 text-xs font-normal text-gray-400 bg-gray-100 px-2 py-0.5 rounded inline-block align-middle leading-none">任意</span>
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          autocomplete="tel"
          placeholder="080-0000-0000"
          class="w-full rounded-lg border border-gray-300 px-4 py-3.5 text-sm text-gray-800 placeholder-gray-400
                 focus:outline-none focus:ring-2 focus:ring-sakura-400 focus:border-transparent transition"
        />
      </div>

      <!-- お問い合わせ種別 -->
      <div>
        <label for="type" class="block text-sm font-medium text-gray-700 mb-2.5">
          お問い合わせ種別
          <span class="ml-1.5 text-xs font-normal text-white bg-sakura-500 px-2 py-0.5 rounded inline-block align-middle leading-none">必須</span>
        </label>
        <div class="relative">
          <select
            id="type"
            name="type"
            required
            class="w-full appearance-none rounded-lg border border-gray-300 px-4 py-3.5 pr-10 text-sm text-gray-800
                   focus:outline-none focus:ring-2 focus:ring-sakura-400 focus:border-transparent transition bg-white"
          >
            <option value="" disabled selected>選択してください</option>
            {typeOptions.map(opt => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
          <!-- カスタム矢印 -->
          <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" aria-hidden="true">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </span>
        </div>
      </div>

      <!-- お問い合わせ内容 -->
      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 mb-2.5">
          お問い合わせ内容
          <span class="ml-1.5 text-xs font-normal text-white bg-sakura-500 px-2 py-0.5 rounded inline-block align-middle leading-none">必須</span>
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          placeholder="ご相談内容をできる限り詳しくお書きください。"
          class="w-full rounded-lg border border-gray-300 px-4 py-3.5 text-sm text-gray-800 placeholder-gray-400
                 focus:outline-none focus:ring-2 focus:ring-sakura-400 focus:border-transparent transition resize-y"
        ></textarea>
      </div>

      <!-- プライバシーポリシー同意 -->
      <div class="flex items-start gap-3">
        <input
          type="checkbox"
          id="privacy"
          name="privacy"
          required
          class="mt-0.5 w-4 h-4 accent-sakura-500 rounded border-gray-300 shrink-0 cursor-pointer"
        />
        <label for="privacy" class="text-sm text-gray-700 leading-relaxed cursor-pointer">
          <a
            href="/privacy"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sakura-600 underline underline-offset-2 hover:text-sakura-800 transition-colors"
          >プライバシーポリシー</a>
          に同意する
          <span class="ml-1.5 text-xs font-normal text-white bg-sakura-500 px-2 py-0.5 rounded inline-block align-middle leading-none">必須</span>
        </label>
      </div>

      <!-- 送信ボタン -->
      <div class="pt-2">
        <button
          type="submit"
          id="submit-btn"
          class="w-full py-4 rounded-lg bg-accent-400 text-gray-900 font-semibold text-base
                 hover:bg-accent-500 active:bg-accent-600 transition-colors
                 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-400
                 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          送信する
        </button>
      </div>
    </form>

    <!-- 直接連絡先 -->
    <div class="mt-14 pt-10 border-t border-gray-200">
      <p class="text-sm text-gray-500 mb-5 text-center">お電話・メールでのお問い合わせも受け付けています。</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`tel:${siteConfig.contact.phone}`}
          class="flex items-center justify-center gap-2 px-6 py-3 rounded-lg border border-sakura-200 text-sakura-700
                 text-sm font-medium hover:bg-sakura-50 transition-colors"
        >
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.47 2 2 0 0 1 3.59 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.54a16 16 0 0 0 6.55 6.55l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          {siteConfig.contact.phone}
        </a>
        <a
          href={`mailto:${siteConfig.contact.email}`}
          class="flex items-center justify-center gap-2 px-6 py-3 rounded-lg border border-sakura-200 text-sakura-700
                 text-sm font-medium hover:bg-sakura-50 transition-colors break-all"
        >
          <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
          </svg>
          {siteConfig.contact.email}
        </a>
      </div>
    </div>

  </div>
</Layout>

<script>
  // ── URLパラメータ → プルダウン初期値 ─────────────────────────────
  const VALID_TYPES = new Set(['request', 'venue', 'join', 'other']);

  const params = new URLSearchParams(window.location.search);
  const typeParam = params.get('type');

  if (typeParam && VALID_TYPES.has(typeParam)) {
    const select = document.getElementById('type') as HTMLSelectElement | null;
    if (select) select.value = typeParam;
  }

  // ── ハニーポット + 送信ガード ──────────────────────────────────
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    const honeypot = form.querySelector<HTMLInputElement>('[name="website"]');
    if (honeypot?.value) {
      // ボット判定：送信を黙ってキャンセル
      e.preventDefault();
      return;
    }
  });
</script>
