---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection, render } from 'astro:content';

const allActivities = await getCollection('activities');
const activities = [...allActivities].sort((a, b) => a.data.priority - b.data.priority);

// 各活動のMarkdown本文を事前にレンダリング
const rendered = await Promise.all(
  activities.map(async act => {
    const { Content } = await render(act);
    return { act, Content };
  })
);
---

<Layout
  title="活動内容"
  description="一般社団法人 桜の風の活動内容をご紹介します。ドッグフェス企画・地域活性化支援・ハンディキャップ支援・動物愛護支援の4つの軸で活動しています。"
  showCTA={true}
>

  <!-- ページヒーロー -->
  <section class="bg-gradient-to-b from-sakura-50 to-white pt-14 pb-10 px-4 md:px-8 text-center">
    <p class="text-xs font-semibold tracking-widest text-sakura-400 uppercase mb-3">Activities</p>
    <h1 class="font-heading text-3xl md:text-4xl font-semibold text-sakura-900">活動内容</h1>
    <div class="mt-4 flex justify-center">
      <span class="block w-14 h-1 rounded-full bg-sakura-300"></span>
    </div>
  </section>

  <!-- リード文 -->
  <div class="max-w-3xl mx-auto px-4 md:px-8 pt-10 pb-2 text-center">
    <p class="text-base md:text-lg text-gray-600 leading-relaxed">
      桜の風は、フェスイベントの企画運営を中心に、<br class="hidden md:inline" />
      地域活性化・ハンディキャップ支援・動物愛護の領域で活動しています。
    </p>
  </div>

  <!-- 活動軸一覧 -->
  <div class="max-w-6xl mx-auto px-4 md:px-8 pb-20 mt-16 space-y-20">
    {rendered.map(({ act, Content }, index) => (
      <section
        id={act.id}
        aria-labelledby={`activity-heading-${act.id}`}
        class="scroll-mt-24"
      >
        <!-- カード + 本文のセット -->
        <div class="flex flex-col md:flex-row gap-10 md:gap-14 items-start">

          <!-- 左カラム：アイコン/画像カード -->
          <div class="shrink-0 w-full md:w-56">
            <div class="rounded-2xl overflow-hidden bg-sakura-50 border border-sakura-100 aspect-square flex items-center justify-center">
              {act.data.image ? (
                <img
                  src={act.data.image}
                  alt={act.data.title}
                  width="224"
                  height="224"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              ) : act.data.icon ? (
                <!-- アイコン名テキスト表示（実アイコンライブラリ導入前の仮表示） -->
                <div class="flex flex-col items-center gap-3 text-sakura-400 p-8">
                  <span class="w-16 h-16 rounded-full bg-sakura-100 flex items-center justify-center">
                    <svg class="w-8 h-8 text-sakura-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <!-- 汎用フラワーアイコン（全活動共通の仮アイコン） -->
                      <circle cx="12" cy="12" r="3"/>
                      <circle cx="12" cy="5"  r="2"/><circle cx="12" cy="19" r="2"/>
                      <circle cx="5"  cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
                      <circle cx="7"  cy="7"  r="2"/><circle cx="17" cy="17" r="2"/>
                      <circle cx="17" cy="7"  r="2"/><circle cx="7"  cy="17" r="2"/>
                    </svg>
                  </span>
                  <span class="text-xs text-sakura-300 text-center font-mono">{act.data.icon}</span>
                </div>
              ) : (
                <!-- 両方なし：デフォルト -->
                <span class="w-16 h-16 rounded-full bg-sakura-500 flex items-center justify-center text-white text-2xl font-bold select-none">桜</span>
              )}
            </div>

            <!-- 優先順位バッジ -->
            <p class="mt-3 text-center">
              <span class="inline-block text-xs text-sakura-400 font-mono">
                0{act.data.priority}
              </span>
            </p>
          </div>

          <!-- 右カラム：見出し + 本文 -->
          <div class="flex-1 min-w-0">
            <h2
              id={`activity-heading-${act.id}`}
              class="font-heading text-2xl md:text-3xl font-semibold text-sakura-900 mb-2 leading-snug"
            >
              {act.data.title}
            </h2>
            <p class="text-sm text-nature-600 font-medium mb-8">{act.data.summary}</p>

            <!-- .md body -->
            <div class="activity-body text-base text-gray-700 leading-[1.9]">
              <Content />
            </div>
          </div>

        </div>

        <!-- セクション区切り（最後の要素以外） -->
        {index < rendered.length - 1 && (
          <hr class="mt-20 border-sakura-100" />
        )}
      </section>
    ))}
  </div>

</Layout>

<style>
  .activity-body :global(p) {
    margin-bottom: 1.1rem;
  }
  .activity-body :global(ul),
  .activity-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.1rem;
  }
  .activity-body :global(li) {
    margin-bottom: 0.35rem;
  }
  .activity-body :global(strong) {
    color: var(--color-sakura-800);
    font-weight: 600;
  }
  .activity-body :global(a) {
    color: var(--color-sakura-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .activity-body :global(a:hover) {
    color: var(--color-sakura-800);
  }
</style>
