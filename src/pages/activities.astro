---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const allActivities = await getCollection('activities');
const activities = [...allActivities].sort((a, b) => a.data.priority - b.data.priority);

const rendered = await Promise.all(
  activities.map(async act => {
    const { Content } = await render(act);
    return { act, Content };
  })
);

const icons: Record<string, string> = {
  'calendar-heart': `
    <path d="M8 2v4M16 2v4M3 10h18" stroke-linecap="round"/>
    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
    <path d="M12 17.5c-1-.8-4-2.8-4-5a2.5 2.5 0 0 1 4-2 2.5 2.5 0 0 1 4 2c0 2.2-3 4.2-4 5z"/>
  `,
  'map-pin': `
    <path d="M12 2a7 7 0 0 0-7 7c0 4.9 7 13 7 13s7-8.1 7-13a7 7 0 0 0-7-7z"/>
    <circle cx="12" cy="9" r="2.5"/>
  `,
  'heart-handshake': `
    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
    <circle cx="9" cy="7" r="4"/>
    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
  `,
  'paw-print': `
    <ellipse cx="12" cy="17.5" rx="4.5" ry="3.5"/>
    <circle cx="7.5" cy="12.5" r="1.8"/>
    <circle cx="16.5" cy="12.5" r="1.8"/>
    <circle cx="9.5" cy="8" r="1.5"/>
    <circle cx="14.5" cy="8" r="1.5"/>
  `,
};

const fallbackIcon = icons['map-pin'];
---

<Layout
  title="活動内容"
  description="一般社団法人 桜の風の活動内容をご紹介します。ドッグフェス企画・地域活性化支援・ハンディキャップ支援・動物愛護支援の4つの軸で活動しています。"
  showCTA={true}
>

  <!-- ページヒーロー -->
  <section class="bg-gradient-to-b from-sakura-50 to-white pt-14 pb-10 px-4 md:px-8 text-center">
    <p class="text-xs font-semibold tracking-widest text-sakura-400 uppercase mb-3">Activities</p>
    <h1 class="font-heading text-3xl md:text-4xl font-semibold text-sakura-900">活動内容</h1>
    <div class="mt-4 flex justify-center">
      <span class="block w-14 h-1 rounded-full bg-sakura-300"></span>
    </div>
  </section>

  <!-- リード文 -->
  <div class="max-w-3xl mx-auto px-4 md:px-8 pt-10 pb-2 text-center">
    <p class="text-base md:text-lg text-gray-600 leading-relaxed">
      桜の風は、フェスイベントの企画運営を中心に、<br class="hidden md:inline" />
      地域活性化・ハンディキャップ支援・動物愛護の領域で活動しています。
    </p>
  </div>

  <!-- 活動軸一覧 -->
  <div class="max-w-6xl mx-auto px-4 md:px-8 pb-20 mt-16 space-y-20">
    {rendered.map(({ act, Content }, index) => (
      <section
        id={act.id}
        aria-labelledby={`activity-heading-${act.id}`}
        class="scroll-mt-24"
      >
        <div class="flex flex-col md:flex-row gap-10 md:gap-14 items-start">

          <!-- 左カラム：連番 + アイコンカード -->
          <div class="shrink-0 w-full max-w-[200px] mx-auto md:mx-0 md:w-52">
            <div class="rounded-2xl bg-gradient-to-br from-sakura-50 to-white border border-sakura-100 px-6 py-8 flex flex-col items-center gap-5">
              <span class="font-heading text-6xl font-bold text-sakura-200 select-none leading-none tracking-tight">
                0{act.data.priority}
              </span>
              <div class="w-16 h-16 rounded-full bg-white shadow-sm flex items-center justify-center">
                <svg
                  class="w-8 h-8 text-sakura-500"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icons[act.data.icon ?? ''] ?? fallbackIcon}
                />
              </div>
            </div>
          </div>

          <!-- 右カラム：見出し + 本文 -->
          <div class="flex-1 min-w-0">
            <h2
              id={`activity-heading-${act.id}`}
              class="font-heading text-2xl md:text-3xl font-semibold text-sakura-900 mb-2 leading-snug"
            >
              {act.data.title}
            </h2>
            <p class="text-sm text-nature-600 font-medium mb-8">{act.data.summary}</p>

            <div class="activity-body text-base text-gray-700 leading-[1.9]">
              <Content />
            </div>
          </div>

        </div>

        {index < rendered.length - 1 && (
          <hr class="mt-20 border-sakura-100" />
        )}
      </section>
    ))}
  </div>

</Layout>

<style>
  .activity-body :global(p) {
    margin-bottom: 1.1rem;
  }
  .activity-body :global(ul),
  .activity-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.1rem;
  }
  .activity-body :global(li) {
    margin-bottom: 0.35rem;
  }
  .activity-body :global(strong) {
    color: var(--color-sakura-800);
    font-weight: 600;
  }
  .activity-body :global(a) {
    color: var(--color-sakura-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .activity-body :global(a:hover) {
    color: var(--color-sakura-800);
  }
</style>
