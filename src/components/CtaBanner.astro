---
interface Props {
  heading?:    string;
  text?:       string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  heading    = '桜の風の活動に関わりませんか？',
  text       = '支援の依頼・活動場所の提供・参加をお待ちしています',
  buttonText = '詳しく見る',
  buttonHref = '/support',
} = Astro.props;
---

<section class="bg-sakura-50 border-t border-b border-sakura-200" aria-labelledby="cta-heading">
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-14 text-center">
    <h2 id="cta-heading" class="font-heading text-2xl md:text-3xl font-semibold text-sakura-900 mb-3">
      {heading}
    </h2>
    <p class="text-base md:text-lg text-gray-700 mb-8 max-w-xl mx-auto leading-relaxed">
      {text}
    </p>
    <a
      href={buttonHref}
      class="inline-block px-8 py-3 rounded-lg bg-accent-500 text-white font-semibold text-base hover:bg-accent-600 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
    >
      {buttonText}
    </a>
  </div>
</section>
