---
const pathname = Astro.url.pathname;

const navLinks = [
  { label: '桜の風について', href: '/about' },
  { label: '活動内容',       href: '/activities' },
  { label: 'イベント情報',   href: '/events' },
  { label: '協力・参加',     href: '/support' },
];

function isActive(href: string): boolean {
  // /events/[slug] など配下も含めてアクティブ判定
  return pathname === href || (href !== '/' && pathname.startsWith(href));
}
---

<!-- スキップリンク（アクセシビリティ） -->
<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded focus:bg-sakura-600 focus:text-white focus:text-sm focus:font-medium"
>
  本文へスキップ
</a>

<header
  id="site-header"
  class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-sakura-100 shadow-sm"
>
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- ロゴ -->
      <a href="/" class="shrink-0 flex items-center" aria-label="一般社団法人 桜の風 — トップページへ">
        <img
          id="site-logo"
          src="/images/logo.png"
          alt="一般社団法人 桜の風"
          style="height:40px;width:auto;max-width:160px;display:block;"
          onerror="document.getElementById('site-logo').style.display='none';document.getElementById('site-logo-fallback').style.display='flex';"
        />
        <!-- 画像未配置時フォールバック -->
        <span id="site-logo-fallback" class="items-center gap-2" style="display:none;" aria-hidden="true">
          <span class="w-8 h-8 rounded-full bg-sakura-500 flex items-center justify-center text-white text-sm font-bold select-none">桜</span>
          <span class="font-heading font-semibold text-sakura-800 text-lg leading-tight">桜の風</span>
        </span>
      </a>

      <!-- PC ナビゲーション -->
      <nav aria-label="グローバルナビゲーション" class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 rounded text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'text-sakura-700 bg-sakura-50 font-semibold underline underline-offset-4 decoration-sakura-400'
                : 'text-gray-700 hover:text-sakura-700 hover:bg-sakura-50',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}

        <!-- CTAボタン -->
        <a
          href="/contact"
          class="ml-3 px-4 py-2 rounded-lg bg-accent-500 text-white text-sm font-semibold hover:bg-accent-600 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
        >
          お問い合わせ
        </a>
      </nav>

      <!-- モバイル：ハンバーガーボタン -->
      <button
        id="menu-toggle"
        type="button"
        class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-sakura-500"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="メニューを開く"
      >
        <span class="hamburger-line block w-6 h-0.5 bg-gray-700 transition-all duration-300"></span>
        <span class="hamburger-line block w-6 h-0.5 bg-gray-700 transition-all duration-300"></span>
        <span class="hamburger-line block w-6 h-0.5 bg-gray-700 transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <!-- モバイルメニューパネル -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-sakura-100 bg-white"
    role="navigation"
    aria-label="モバイルナビゲーション"
  >
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-4 py-3 rounded-lg text-sm font-medium transition-colors',
            isActive(link.href)
              ? 'text-sakura-700 bg-sakura-50 font-semibold'
              : 'text-gray-700 hover:text-sakura-700 hover:bg-sakura-50',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact"
        class="mt-2 px-4 py-3 rounded-lg bg-accent-500 text-white text-sm font-semibold text-center hover:bg-accent-600 transition-colors"
      >
        お問い合わせ
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニューを開く');

    // ハンバーガー → × の変形
    const lines = toggle.querySelectorAll<HTMLElement>('.hamburger-line');
    if (isOpen) {
      lines[0].style.transform = 'translateY(8px) rotate(45deg)';
      lines[1].style.opacity   = '0';
      lines[2].style.transform = 'translateY(-8px) rotate(-45deg)';
    } else {
      lines[0].style.transform = '';
      lines[1].style.opacity   = '';
      lines[2].style.transform = '';
    }
  });

  // ページ遷移後にメニューを閉じる
  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'メニューを開く');
      const lines = toggle?.querySelectorAll<HTMLElement>('.hamburger-line');
      lines?.forEach((l) => { l.style.transform = ''; l.style.opacity = ''; });
    });
  });
</script>
