---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';

const SITE_NAME = '一般社団法人 桜の風';

interface Props {
  /** <title> 用テキスト。トップページは未指定でサイト名単独になる */
  title?: string;
  description?: string;
  /** CTA誘導バナーの表示/非表示（デフォルト true）*/
  showCTA?: boolean;
}

const {
  title,
  description = '一般社団法人 桜の風の公式ウェブサイト。ドッグフェス・地域イベントの企画運営、地域活性化支援、ハンディキャップ支援、動物愛護支援を行っています。',
  showCTA = true,
} = Astro.props;

// トップページはサイト名単独、他ページは「{title} ｜ {サイト名}」
const pageTitle = title ? `${title} ｜ ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : '';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- OGP -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content="/og-image.png" />

    <!-- favicon（仮置き） -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="flex flex-col min-h-dvh">
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    {showCTA && <CtaBanner />}
    <Footer />
  </body>
</html>
